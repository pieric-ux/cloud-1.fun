#!/bin/bash
# First-boot hook for {{ inventory_hostname }}, embedded in the auto-install ISO.
# Generated by Ansible from the inventory: do not edit the rendered file.
#
# The answer file can only put a plain IP on one NIC. This writes the real
# layout before networking starts: LACP bond0 -> VLAN-aware vmbr0 with mgmt on
# vmbr0.{{ pve_net_mgmt_vlan }}, storage on vmbr0.{{ pve_net_storage_vlan }}, and the direct bond1 link.
# NICs are matched by permanent MAC, so interface naming does not matter.
set -euo pipefail

name_of() {
    for dev in /sys/class/net/*; do
        if [ "$(cat "$dev/address")" = "$1" ]; then
            basename "$dev"
            return
        fi
    done
    echo "first-boot: no interface with MAC $1" >&2
    exit 1
}

# One substitution per assignment: with several in one line, set -e only sees
# the status of the last one and a missing MAC would go unnoticed.
BOND0_SLAVES=""
for mac in {{ pve_net_bond0_macs | join(' ') }}; do
    BOND0_SLAVES+="$(name_of "$mac") "
done
BOND1_SLAVES=""
for mac in {{ pve_net_bond1_macs | join(' ') }}; do
    BOND1_SLAVES+="$(name_of "$mac") "
done
BOND0_SLAVES="${BOND0_SLAVES% }"
BOND1_SLAVES="${BOND1_SLAVES% }"

{
    echo "auto lo"
    echo "iface lo inet loopback"
    echo
    for nic in $BOND0_SLAVES $BOND1_SLAVES; do
        echo "auto $nic"
        echo "iface $nic inet manual"
        echo
    done
    cat <<EOF
auto bond0
iface bond0 inet manual
	bond-slaves $BOND0_SLAVES
	bond-miimon 100
	bond-mode 802.3ad
	bond-xmit-hash-policy layer2+3

auto bond1
iface bond1 inet static
	address {{ pve_net_bond1_cidr }}
	bond-slaves $BOND1_SLAVES
	bond-miimon 100
	bond-mode 802.3ad
	mtu {{ pve_net_bond1_mtu }}

auto vmbr0
iface vmbr0 inet manual
	bridge-ports bond0
	bridge-stp off
	bridge-fd 0
	bridge-vlan-aware yes
	bridge-vids {{ pve_net_bridge_vids | join(' ') }}

auto vmbr0.{{ pve_net_mgmt_vlan }}
iface vmbr0.{{ pve_net_mgmt_vlan }} inet static
	address {{ pve_install_mgmt_cidr }}
	gateway {{ pve_install_gateway }}

auto vmbr0.{{ pve_net_storage_vlan }}
iface vmbr0.{{ pve_net_storage_vlan }} inet static
	address {{ pve_net_storage_cidr }}

source /etc/network/interfaces.d/*
EOF
} > /etc/network/interfaces
