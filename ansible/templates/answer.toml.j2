# Proxmox VE {{ pve_install_version }} automated installation answer for {{ inventory_hostname }}.
# Generated by Ansible from the inventory: do not edit the rendered file.
# Keys follow the 9.x format (kebab-case).

[global]
keyboard = {{ pve_install_keyboard | to_json }}
country = {{ pve_install_country | to_json }}
fqdn = {{ ansible_host | to_json }}
mailto = {{ pve_install_mailto | to_json }}
timezone = {{ pve_install_timezone | to_json }}
root-password-hashed = {{ pve_install_root_password_hash | to_json }}
root-ssh-keys = {{ pve_install_root_ssh_keys | to_json }}
reboot-on-error = false

# Plain IP on the management NIC only. The real layout (LACP bond0 + bond1,
# VLAN-aware vmbr0, mgmt on vmbr0.240) is not expressible here: the first-boot
# hook embedded in the ISO writes it before networking starts.
[network]
source = "from-answer"
cidr = {{ pve_install_mgmt_cidr | to_json }}
gateway = {{ pve_install_gateway | to_json }}
dns = {{ pve_install_dns | to_json }}
filter.ID_NET_NAME_MAC = {{ ('*' ~ (pve_install_mgmt_mac | replace(':', ''))) | to_json }}

# Exact match on the Smart Array logical drive: if it is not found (RAID
# rebuilt, wrong host), no disk matches and the install aborts instead of
# picking another disk.
[disk-setup]
filesystem = {{ pve_install_filesystem | to_json }}
filter.ID_SERIAL = {{ pve_install_disk_serial | to_json }}

# Network hook (first-boot.sh, embedded by prepare-iso --on-first-boot).
[first-boot]
source = "from-iso"
ordering = "before-network"
