upstream wifi {
    zone wifi 64k;
    server {{ rproxy_ip['wifi-ap'] }}:80;
    keepalive 2;
}

server {
    listen 80;
    server_name wifi.cloud-1.fun;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name wifi.cloud-1.fun;

    ssl_certificate     /etc/letsencrypt/live/cloud-1.fun/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cloud-1.fun/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000;";

    client_max_body_size 10M;
    # L'AP (IOS 15.3) ne propose que RC4/DES/3DES, refusés par OpenSSL 3 :
    # backend en HTTP, restreint à 10.1.240.33 par l'ACL 10 sur l'AP.

    location / {
        proxy_pass http://wifi;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
