# {{ ansible_managed }}
{% raw %}
groups:
  - name: host
    rules:
      - alert: HostDown
        expr: up == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "{{ $labels.instance }} ({{ $labels.job }}) is down"
          description: "Target {{ $labels.instance }} has been unreachable for more than 2 minutes."

      - alert: HostDiskCritical
        expr: 100 * (1 - node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"}) > 90
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "{{ $labels.instance }} root filesystem over 90%"
          description: "Root filesystem on {{ $labels.instance }} is at {{ $value | printf \"%.1f\" }}%."

      - alert: HostDiskFull
        expr: 100 * (1 - node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"}) > 80
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.instance }} root filesystem over 80%"
          description: "Root filesystem on {{ $labels.instance }} is at {{ $value | printf \"%.1f\" }}%."

      - alert: HostMemoryLow
        expr: 100 * node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes < 10
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.instance }} available memory below 10%"
          description: "{{ $labels.instance }} has {{ $value | printf \"%.1f\" }}% memory available."

      - alert: HostCpuHigh
        expr: 100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode="idle"}[5m]))) > 90
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.instance }} CPU usage above 90%"
          description: "{{ $labels.instance }} CPU at {{ $value | printf \"%.1f\" }}% for more than 10 minutes."

      - alert: HostRebootDetected
        expr: time() - node_boot_time_seconds < 300
        labels:
          severity: info
        annotations:
          summary: "{{ $labels.instance }} rebooted"
          description: "{{ $labels.instance }} booted less than 5 minutes ago."

  - name: proxmox
    rules:
      - alert: PveStorageFull
        expr: 100 * pve_disk_usage_bytes{id=~"storage/.*"} / pve_disk_size_bytes{id=~"storage/.*"} > 85
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Proxmox storage {{ $labels.id }} over 85%"
          description: "Storage {{ $labels.id }} is at {{ $value | printf \"%.1f\" }}%."

  - name: network
    rules:
      - alert: SwitchInterfaceErrors
        expr: rate(ifInErrors[5m]) + rate(ifOutErrors[5m]) > 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Interface errors on {{ $labels.ifDescr }} ({{ $labels.instance }})"
          description: "{{ $labels.ifDescr }} on {{ $labels.instance }} has {{ $value | printf \"%.2f\" }} errors/s."
{% endraw %}

