# {{ ansible_managed }}
[Unit]
Description=Prometheus PVE Exporter
Documentation=https://github.com/prometheus-pve/prometheus-pve-exporter
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User={{ pve_exporter_user }}
Group={{ pve_exporter_user }}
ExecStart={{ pve_exporter_venv }}/bin/pve_exporter --config.file {{ pve_exporter_config }} --web.listen-address {{ pve_exporter_listen_address }}:{{ pve_exporter_port }} {{ pve_exporter_extra_args }}
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
