---
extends: default
# Vault files are encrypted, not YAML.
ignore: |
  **/vault.yml
  files/
rules:
  # Generated files (host_vars from the snapshot filters) do not indent
  # sequences, hand-written ones do: both are valid YAML.
  indentation:
    indent-sequences: whatever
  line-length: disable
  truthy:
    allowed-values: ["true", "false"]
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
